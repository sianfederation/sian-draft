# Requires Ruby 3.3 (Ruby 4.0 breaks Liquid 4 in the github-pages gem).
#
#   export PATH="/opt/homebrew/opt/ruby@3.3/bin:$PATH"
#   bundle install
#   PAGES_REPO_NWO=sianfederation/sian-draft bundle exec jekyll serve --baseurl /sian
#
# Then open http://localhost:4000/sian/

